{
  "name": "sveltick",
  "version": "2.0.0-next.0",
  "description": "Document performance and navigation activity for Svelte and SvelteKit",
  "main": "dist/sveltick.cjs",
  "module": "dist/sveltick.es.js",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/sveltick.es.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/sveltick.cjs"
      }
    }
  },
  "type": "module",
  "scripts": {
    "test": "jest --config jest.config.ts",
    "build": "tsx scripts/build.ts",
    "format": "prettier --write .",
    "check": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json && tsc --noEmit -p tsconfig.tools.json",
    "lint": "prettier --check .",
    "prepack": "npm run check && npm test -- --runInBand && npm run lint && npm run build"
  },
  "devDependencies": {
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-terser": "^1.0.0",
    "@rollup/plugin-typescript": "^12.3.0",
    "@types/jest": "^30.0.0",
    "prettier": "^3.3.3",
    "rollup": "^4.24.0",
    "rollup-plugin-dts": "^6.5.1",
    "ts-jest": "^29.4.14",
    "ts-node": "^10.9.2",
    "tslib": "^2.8.1"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Adam014/sveltick.git"
  },
  "author": "Adam014",
  "keywords": [
    "svelte",
    "performance",
    "tracking",
    "lightweight"
  ],
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES"
  ],
  "dependencies": {
    "web-vitals": "^6.2.3"
  }
}
